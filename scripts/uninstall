#!/bin/bash
# Wrapper script - downloads and executes uninstall
# Supports multiple URL patterns:
#   curl -fsSL https://clix.sh/uninstall | bash
#
# Environment variables are passed through to uninstall:
#   CLIX_INSTALL_DIR

CLIX_INSTALL_DIR="${CLIX_INSTALL_DIR:-}" \
  bash -c "$(curl -fsSL https://clix.sh/uninstall.sh)"
