{
  "name": "@clix-so/clix-cli",
  "version": "1.1.1",
  "description": "A CLI tool for integrating and managing the Clix SDK in your mobile projects",
  "type": "module",
  "bin": {
    "clix": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run src/cli.tsx",
    "build": "bun run scripts/build.ts",
    "build:binary": "bun run scripts/compile.ts",
    "build:binary:checksums": "bun run scripts/compile.ts --checksums",
    "install:local": "bun run scripts/install-local.ts",
    "changelog": "bun run scripts/changelog.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:unit": "bun test src/lib",
    "test:e2e": "bun test tests/e2e",
    "typecheck": "tsc --noEmit",
    "start": "bun dist/cli.js",
    "lint": "biome check src tests scripts",
    "lint:fix": "biome check --write --unsafe src tests scripts",
    "format": "biome format --write src tests scripts",
    "check": "bun run lint && bun run typecheck",
    "prepare": "husky"
  },
  "keywords": [
    "clix",
    "sdk",
    "cli",
    "mobile",
    "ios",
    "android",
    "push-notifications"
  ],
  "author": "Clix",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clix-so/clix-cli.git"
  },
  "homepage": "https://docs.clix.so/clix-cli",
  "dependencies": {
    "@clix-so/clix-agent-skills": "^0.2.3",
    "@expo/apple-utils": "^2.1.14",
    "@expo/plist": "^0.4.8",
    "asciify-image": "^0.1.10",
    "google-auth-library": "^10.5.0",
    "ink": "^6.6.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "meow": "^14.0.0",
    "open": "^11.0.0",
    "picocolors": "^1.1.1",
    "plist": "^3.1.0",
    "react": "^19.2.3",
    "xdg-app-paths": "^8.3.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "^1.3.5",
    "@types/node": "^22.10.5",
    "@types/plist": "^3.0.5",
    "@types/react": "^19.2.7",
    "husky": "^9.0.0",
    "lint-staged": "^16.2.7",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
